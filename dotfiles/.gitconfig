[user]
	name = Patric Fornasier
	email = patric.fornasier@gmail.com

# --- Workflow defaults ---
[pull]
	rebase = true
	ff = only
[rebase]
	autoStash = true
[fetch]
	prune = true
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[merge]
	conflictStyle = zdiff3

# --- Editor & ignore ---
[core]
	editor = nvim
	autocrlf = false

# --- Colors & pager (delta) ---
[color]
	ui = auto
[delta]
	navigate = true       # jump between hunks with n/N
	line-numbers = true
[interactive]
	diffFilter = delta --color-only
[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

# --- Rerere keeps conflict resolutions for reuse ---
[rerere]
	enabled = true

# --- Credentials (macOS keychain) ---
[credential]
	helper = osxkeychain

# --- (optional) signing ---
# [commit]
# 	gpgsign = true
# [gpg]
# 	program = gpg