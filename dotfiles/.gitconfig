[user]
	name = Patric Fornasier
	email = the configured Gmail account

# --- Workflow defaults ---
[pull]
	rebase = true
	ff = only
[rebase]
	autoStash = true
[fetch]
	prune = true
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[merge]
	conflictStyle = zdiff3

# --- Editor & ignore ---
[core]
	editor = nvim
	autocrlf = false
	pager = delta         # catch-all diff pager: diff, show, log, range-diff, stash show -p, …

# --- Colors & pager (delta) ---
[color]
	ui = auto
[delta]
	navigate = true       # jump between hunks with n/N
	line-numbers = true
	hyperlinks = true     # OSC 8 clickable paths (Ghostty supports)
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"   # click a path -> open VS Code at that line
[interactive]
	diffFilter = delta --color-only

# --- Rerere keeps conflict resolutions for reuse ---
[rerere]
	enabled = true

# --- Credentials (macOS keychain) ---
[credential]
	helper = osxkeychain

# --- (optional) signing ---
# [commit]
# 	gpgsign = true
# [gpg]
# 	program = gpg