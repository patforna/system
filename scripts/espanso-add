#!/usr/bin/env bash
# Add an espanso shortcut and reload the config.
# Usage: espanso-add <trigger> <replacement>

set -euo pipefail

BASE_YML="$HOME/github/system/dotfiles/.config/espanso/match/base.yml"

usage() {
  echo "Usage: espanso-add <trigger> <replacement>"
  exit 1
}

if [[ $# -eq 2 ]]; then
  trigger="$1"
  replacement="$2"
else
  usage
fi

[[ "$trigger" != :* ]] && trigger=":$trigger"

# Bail if trigger already exists
if grep -qF "trigger: \"$trigger\"" "$BASE_YML" || grep -qF "trigger: '$trigger'" "$BASE_YML"; then
  echo "Error: trigger '$trigger' already exists in base.yml"
  exit 1
fi

# Insert the new entry, keeping base.yml sorted alphabetically by trigger
BASE_YML="$BASE_YML" TRIGGER="$trigger" REPL="$replacement" \
  uv run --no-project python3 - <<'PY'
import os, re, pathlib
p = pathlib.Path(os.environ["BASE_YML"])
esc = os.environ["REPL"].replace("\\", "\\\\").replace('"', '\\"')
new = ['  - trigger: "%s"' % os.environ["TRIGGER"], '    replace: "%s"' % esc]

entries, cur = [], []
for ln in p.read_text().splitlines()[1:]:           # skip "matches:" header
    if re.match(r"^  - trigger:", ln):
        if cur: entries.append(cur)
        cur = [ln]
    elif cur:
        cur.append(ln)
if cur: entries.append(cur)
for b in entries:
    while b and b[-1].strip() == "":                # drop trailing blanks per block
        b.pop()
entries.append(new)
entries.sort(key=lambda b: re.search(r'trigger:\s*["\']?(.*?)["\']?\s*$', b[0]).group(1).lower())

out = ["matches:"]
for b in entries:
    out.append(""); out.extend(b)
p.write_text("\n".join(out) + "\n")
PY

echo "Added: $trigger → $replacement"

# Commit and push (system repo convention)
cd "$HOME/github/system"
git add dotfiles/.config/espanso/match/base.yml
git commit -m "espanso: add $trigger shortcut"
git push

# Reload espanso
espanso restart
echo "Espanso reloaded."
