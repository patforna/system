#!/usr/bin/env bash
set -euo pipefail

# Snapshot the dev droplet and destroy it to stop billing.
# Usage: dev-down

DROPLET_NAME="dev"
SNAPSHOT_NAME="dev-snapshot"

# --- Preflight ---
if ! command -v doctl &>/dev/null; then
  echo "doctl not installed. Run: brew install doctl && doctl auth init"
  exit 1
fi

DROPLET_ID=$(doctl compute droplet list "$DROPLET_NAME" --format ID --no-header)
if [[ -z "$DROPLET_ID" ]]; then
  echo "No droplet named '$DROPLET_NAME' found. Already snapshotted?"
  exit 1
fi

echo "Droplet: $DROPLET_NAME (ID: $DROPLET_ID)"

# --- Uptime & cost ---
DROPLET_JSON=$(doctl compute droplet get "$DROPLET_ID" --output json)
SIZE_SLUG=$(echo "$DROPLET_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)[0]['size_slug'])")

# Pick the most recent 'create' action's started_at (when dev-up restored this
# instance). doctl returns droplet actions newest-first, so the first match is
# the latest create. The ISO timestamp ends in 'Z' (UTC) and must be parsed as
# such — `date -jf "...Z" ...` on macOS silently treats the string as local
# time, which over-stated uptime by the local UTC offset (~2 h in CEST).
export ACTIONS_JSON DROPLET_JSON HOURLY_RATE
ACTIONS_JSON=$(doctl compute droplet actions "$DROPLET_ID" --output json)
HOURLY_RATE=$(doctl compute size list --format Slug,PriceHourly --no-header | awk -v s="$SIZE_SLUG" '$1==s {print $2}')

# Non-fatal: this block is purely cosmetic, and under set -e a failure here
# (e.g. HOURLY_RATE empty because the size slug vanished from `doctl size
# list`) must not abort the script before the snapshot/destroy — the one job
# that actually stops billing.
if ! IFS=$'\t' read -r UPTIME_HOURS UPTIME_MINS COST < <(python3 <<'PY'
import json, os
from datetime import datetime, timezone

actions = json.loads(os.environ["ACTIONS_JSON"])
fallback = json.loads(os.environ["DROPLET_JSON"])[0]["created_at"]
create = next((a for a in actions if a["type"] == "create"), None)
created_at = create["started_at"] if create else fallback

created = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
now = datetime.now(timezone.utc)
secs = int((now - created).total_seconds())
hours, mins = divmod(secs // 60, 60)

rate = float(os.environ["HOURLY_RATE"])
billable = hours + 1  # DO bills hourly, 1 h minimum, rounds up
print(f"{hours}\t{mins}\t{billable}h × ${rate} = ${billable * rate:.2f}")
PY
); then
  UPTIME_HOURS="?" UPTIME_MINS="?" COST="(unavailable)"
fi

echo "Uptime:  ${UPTIME_HOURS}h ${UPTIME_MINS}m"
echo "Cost:    $COST (billed hourly)"
echo ""

# --- Clean up any previous snapshot ---
OLD_SNAP=$(doctl compute snapshot list "$SNAPSHOT_NAME" --resource droplet --format ID --no-header 2>/dev/null || true)
if [[ -n "$OLD_SNAP" ]]; then
  echo "Deleting previous snapshot ($OLD_SNAP)..."
  doctl compute snapshot delete "$OLD_SNAP" --force
fi

# --- Shutdown ---
echo "Shutting down droplet..."
doctl compute droplet-action shutdown "$DROPLET_ID" --wait

# --- Snapshot ---
echo "Creating snapshot '$SNAPSHOT_NAME' (this takes a few minutes)..."
doctl compute droplet-action snapshot "$DROPLET_ID" --snapshot-name "$SNAPSHOT_NAME" --wait

SNAPSHOT_ID=$(doctl compute snapshot list "$SNAPSHOT_NAME" --resource droplet --format ID --no-header)
echo "Snapshot created (ID: $SNAPSHOT_ID)"

# --- Destroy ---
echo "Destroying droplet..."
doctl compute droplet delete "$DROPLET_ID" --force

echo ""
echo "Done. Droplet destroyed, snapshot saved."
echo "Restore with: dev-up"
