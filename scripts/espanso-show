#!/usr/bin/env bash
set -euo pipefail

BASE_YML="$HOME/github/system/dotfiles/.config/espanso/match/base.yml"

if [[ "${1:-}" == --o* || "${1:-}" == -o ]]; then
  ${EDITOR:-nvim} "$BASE_YML"
  exit 0
fi

echo "$BASE_YML"
echo
awk '
  function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
  function unquote(s) {
    if (s ~ /^".*"$/ || s ~ /^'\''.*'\''$/) s = substr(s, 2, length(s) - 2)
    return s
  }
  # block-scalar mode: collect indented body lines, deferring blanks so trailing ones are dropped
  block {
    if ($0 ~ /^[[:space:]]*$/) { pending = pending $0 "\n"; next }
    match($0, /^[[:space:]]*/)
    if (RLENGTH > repl_indent) { printf "%s%s%s\n", pending, "    ", trim($0); pending = ""; next }
    block = 0; pending = ""   # dedent ends the block; fall through to reparse this line
  }
  /^[[:space:]]*- trigger:/ {
    line = $0; sub(/^[[:space:]]*- trigger:[[:space:]]*/, "", line)
    trigger = unquote(trim(line)); next
  }
  /^[[:space:]]*replace:/ {
    match($0, /^[[:space:]]*/); repl_indent = RLENGTH
    val = $0; sub(/^[[:space:]]*replace:[[:space:]]*/, "", val)
    if (val ~ /^[|>]/) { print trigger " →"; block = 1 }        # block scalar: body on following lines
    else print trigger " → " unquote(trim(val))
  }
' "$BASE_YML"
