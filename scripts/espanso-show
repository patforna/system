#!/usr/bin/env bash
set -euo pipefail

BASE_YML="$HOME/github/system/dotfiles/.config/espanso/match/base.yml"

if [[ "${1:-}" == --o* || "${1:-}" == -o ]]; then
  ${EDITOR:-nvim} "$BASE_YML"
  exit 0
fi

echo "$BASE_YML"
echo
awk '
  function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
  function unquote(s) {
    if (s ~ /^".*"$/ || s ~ /^'\''.*'\''$/) s = substr(s, 2, length(s) - 2)
    return s
  }
  function show(t, v) {
    if (length(v) > 80) v = substr(v, 1, 80) "…"
    print t " → " v
  }
  # block scalar: show first body line only, then skip the rest
  block { block = 0; show(trigger, trim($0)); next }
  /^[[:space:]]*- trigger:/ {
    line = $0; sub(/^[[:space:]]*- trigger:[[:space:]]*/, "", line)
    trigger = unquote(trim(line)); next
  }
  /^[[:space:]]*replace:/ {
    val = $0; sub(/^[[:space:]]*replace:[[:space:]]*/, "", val)
    if (val ~ /^[|>]/) block = 1                # block scalar: first body line follows
    else show(trigger, unquote(trim(val)))
  }
' "$BASE_YML"
