#!/usr/bin/env python3
"""claude-replay - Extract a Claude Code session transcript as readable markdown.

After an /auto-task run (or any session with subagents), you often want to read the
full prompt + response of each subagent without the TUI's truncation. This tool reads
the session's JSONL log under ~/.claude/projects/<encoded-cwd>/<uuid>.jsonl, pairs
every Agent tool_use with its tool_result (matched by tool_use_id), and emits
markdown — including main-thread assistant text and Bash calls so the full session
arc is preserved.

UUIDs are resolved globally under ~/.claude/projects/ so the same UUID works from
any working directory. With no UUID argument, falls back to the latest session in
the cwd's project (`--list` to browse, `--commit <hash>` to locate via find-session,
`--recurse-subagents` to inline each subagent's own trace in a collapsible block).

Stdlib only.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from pydoc import pager


PROJECTS_DIR = Path.home() / ".claude" / "projects"


# ---------------------------------------------------------------------------
# Locating sessions
# ---------------------------------------------------------------------------


def encode_project_path(path: Path) -> str:
    """Mirror Claude Code's project-dir encoding: replace / with -."""
    return str(path).replace("/", "-")


def resolve_project_root(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).expanduser().resolve()
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
        return Path(out.stdout.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return Path.cwd()


def project_session_dir(project_root: Path) -> Path:
    return PROJECTS_DIR / encode_project_path(project_root)


def project_session_dirs(project_root: Path) -> list[Path]:
    """All Claude project dirs that belong to this project root.

    Includes the canonical encoded dir plus any sibling worktree dirs whose
    encoded slug starts with the canonical slug + "-" (Claude encodes worktree
    paths like `/Users/.../tad/.claude-worktrees/task-NNN` under their own
    project dirs alongside the main one).
    """
    base = encode_project_path(project_root)
    dirs: list[Path] = []
    main = PROJECTS_DIR / base
    if main.is_dir():
        dirs.append(main)
    if PROJECTS_DIR.is_dir():
        for d in PROJECTS_DIR.iterdir():
            if d.is_dir() and d.name.startswith(base + "-") and d != main:
                dirs.append(d)
    return dirs


def list_sessions(project_root: Path) -> list[Path]:
    files: list[Path] = []
    for d in project_session_dirs(project_root):
        files.extend(p for p in d.iterdir() if p.is_file() and p.suffix == ".jsonl")
    files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    return files


def latest_session(project_root: Path) -> Path | None:
    sessions = list_sessions(project_root)
    return sessions[0] if sessions else None


def session_by_uuid(uuid: str) -> Path | None:
    """Locate a session JSONL by UUID anywhere under ~/.claude/projects/.

    Searched globally so the same UUID resolves no matter which directory the
    caller is in. Subagent sessions live under <project>/subagents/<uuid>.jsonl
    and are matched by the same recursive walk.
    """
    if not PROJECTS_DIR.is_dir():
        return None
    for cand in PROJECTS_DIR.rglob(f"{uuid}.jsonl"):
        if cand.is_file():
            return cand
    return None


def session_via_commit(commit: str) -> Path | None:
    """Use `find-session <hash>` to locate the authoring session, return its jsonl path."""
    try:
        out = subprocess.run(
            ["find-session", commit],
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        print("error: find-session not on PATH", file=sys.stderr)
        return None
    if out.returncode != 0:
        # find-session printed diagnostics to stderr; surface and bail
        sys.stderr.write(out.stderr)
        sys.stderr.write(out.stdout)
        return None
    uuid = None
    for line in out.stdout.splitlines():
        line = line.strip()
        if line.startswith("[authoring]"):
            # Format: "[authoring] <uuid>"
            parts = line.split()
            if len(parts) >= 2:
                uuid = parts[1]
                break
    if uuid is None:
        sys.stderr.write(out.stdout)
        return None
    # Search every project (and its subagents/ dirs) for this uuid.
    for cand in PROJECTS_DIR.rglob(f"{uuid}.jsonl"):
        if cand.is_file():
            return cand
    return None


# ---------------------------------------------------------------------------
# Parsing
# ---------------------------------------------------------------------------


def load_records(path: Path) -> list[dict]:
    records = []
    with path.open() as f:
        for i, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError as exc:
                print(f"warning: skipping malformed line {i}: {exc}", file=sys.stderr)
    return records


def extract_text(content) -> str:
    """Normalise message.content (str or list-of-blocks) to plain text."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        chunks = []
        for block in content:
            if not isinstance(block, dict):
                continue
            t = block.get("type")
            if t == "text":
                chunks.append(block.get("text", ""))
            # tool_use / tool_result / image blocks: skip (handled separately)
        return "\n".join(chunks)
    return ""


def extract_tool_result_text(tr_content) -> str:
    """tool_result.content can be a string or a list of blocks."""
    if isinstance(tr_content, str):
        return tr_content
    if isinstance(tr_content, list):
        chunks = []
        for block in tr_content:
            if isinstance(block, dict) and block.get("type") == "text":
                chunks.append(block.get("text", ""))
        return "\n".join(chunks)
    return ""


def session_metadata(records: list[dict]) -> dict:
    meta = {"session_id": None, "project": None, "started": None, "title": None}
    for rec in records:
        t = rec.get("type")
        if t == "user" and rec.get("parentUuid") is None and meta["started"] is None:
            meta["started"] = rec.get("timestamp")
            meta["project"] = rec.get("cwd")
            meta["session_id"] = rec.get("sessionId") or meta["session_id"]
        if t == "ai-title" and not meta["title"]:
            meta["title"] = rec.get("aiTitle")
        if rec.get("sessionId") and not meta["session_id"]:
            meta["session_id"] = rec["sessionId"]
    return meta


def collect_events(records: list[dict]) -> list[dict]:
    """Walk records once; yield a chronological list of events.

    Each event is a dict with: kind (agent_call | assistant_text | bash_call | bash_result),
    timestamp, and kind-specific fields.

    Agent calls are paired with their tool_result text. Bash calls likewise.
    """
    # Build tool_use_id -> tool_result_text lookup from user records.
    tool_results: dict[str, str] = {}
    for rec in records:
        if rec.get("type") != "user":
            continue
        content = rec.get("message", {}).get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if isinstance(block, dict) and block.get("type") == "tool_result":
                tid = block.get("tool_use_id")
                if tid:
                    tool_results[tid] = extract_tool_result_text(block.get("content"))

    events = []
    for rec in records:
        if rec.get("type") != "assistant":
            continue
        ts = rec.get("timestamp")
        content = rec.get("message", {}).get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict):
                continue
            btype = block.get("type")
            if btype == "tool_use" and block.get("name") == "Agent":
                inp = block.get("input", {}) or {}
                tid = block.get("id")
                events.append({
                    "kind": "agent_call",
                    "timestamp": ts,
                    "id": tid,
                    "description": inp.get("description", ""),
                    "subagent_type": inp.get("subagent_type"),
                    "prompt": inp.get("prompt", ""),
                    "response": tool_results.get(tid),
                })
            elif btype == "tool_use" and block.get("name") == "Bash":
                inp = block.get("input", {}) or {}
                tid = block.get("id")
                events.append({
                    "kind": "bash_call",
                    "timestamp": ts,
                    "id": tid,
                    "command": inp.get("command", ""),
                    "description": inp.get("description", ""),
                    "output": tool_results.get(tid),
                })
            elif btype == "text":
                text = block.get("text", "").strip()
                if text:
                    events.append({
                        "kind": "assistant_text",
                        "timestamp": ts,
                        "text": text,
                    })
    return events


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------


def render_header(session_path: Path, meta: dict) -> str:
    uuid = session_path.stem
    lines = [f"# Claude Code session {uuid}", ""]
    if meta.get("project"):
        lines.append(f"Project: {meta['project']}")
    if meta.get("started"):
        lines.append(f"Started: {meta['started']}")
    if meta.get("title"):
        lines.append(f"Title: {meta['title']}")
    lines.append("")
    lines.append("---")
    return "\n".join(lines)


def render_agent_event(idx: int, ev: dict) -> str:
    desc = ev.get("description") or "(no description)"
    stype = ev.get("subagent_type")
    suffix = f" [{stype}]" if stype else ""
    out = [
        "",
        f"## Subagent {idx}: {desc}{suffix}",
        f"Time: {ev.get('timestamp')}",
        "",
        "### Prompt",
        "",
        ev.get("prompt") or "(empty prompt)",
        "",
        "### Response",
        "",
    ]
    resp = ev.get("response")
    if resp is None:
        out.append("(no matching tool_result — orphan prompt)")
    else:
        out.append(resp or "(empty response)")
    out.append("")
    out.append("---")
    return "\n".join(out)


def render_assistant_text_event(ev: dict) -> str:
    return "\n".join([
        "",
        f"## Main-thread message",
        f"Time: {ev.get('timestamp')}",
        "",
        ev.get("text", ""),
        "",
        "---",
    ])


def render_bash_event(ev: dict) -> str:
    cmd = ev.get("command", "")
    desc = ev.get("description") or ""
    out_text = ev.get("output")
    lines = [
        "",
        "## Bash call",
        f"Time: {ev.get('timestamp')}",
    ]
    if desc:
        lines.append(f"Description: {desc}")
    lines += [
        "",
        "### Command",
        "",
        "```",
        cmd,
        "```",
        "",
        "### Output",
        "",
    ]
    lines.append("```")
    lines.append(out_text if out_text is not None else "(no matching tool_result)")
    lines.append("```")
    lines.append("")
    lines.append("---")
    return "\n".join(lines)


def subagent_dir_for(jsonl_path: Path) -> Path:
    """Where Claude Code stores subagent JSONLs spawned from `jsonl_path`.

    For a main session at `<project>/<uuid>.jsonl`, subagents live at
    `<project>/<uuid>/subagents/agent-<id>.jsonl`. The same pattern repeats if
    a subagent itself spawns a subagent.
    """
    return jsonl_path.with_suffix("") / "subagents"


def index_subagents(parent_jsonl: Path) -> list[tuple[Path, dict]]:
    """Return [(jsonl_path, meta_dict)] for each subagent spawned from `parent_jsonl`.

    Sorted by file mtime so the order roughly tracks the parent's call order —
    enough for first-match-wins matching against agent_call events.
    """
    sub_dir = subagent_dir_for(parent_jsonl)
    if not sub_dir.is_dir():
        return []
    out: list[tuple[Path, dict, float]] = []
    for meta_path in sub_dir.glob("*.meta.json"):
        jsonl = meta_path.with_name(meta_path.name[: -len(".meta.json")] + ".jsonl")
        if not jsonl.is_file():
            continue
        try:
            meta = json.loads(meta_path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        out.append((jsonl, meta, jsonl.stat().st_mtime))
    out.sort(key=lambda x: x[2])
    return [(p, m) for p, m, _ in out]


def match_subagent(
    agent_event: dict,
    candidates: list[tuple[Path, dict]],
    used: set[Path],
) -> Path | None:
    """First unused candidate whose meta.json matches the agent_call event.

    The main thread's `Agent` tool_use id does not correspond to the
    subagent's filename `agentId`, so we match on metadata instead. Pass 1
    requires both (description, agentType); pass 2 falls back to agentType
    alone, in mtime order — necessary because ~45% of historical meta.json
    files were written without a description field. Consume-once ensures
    duplicate matches still map 1:1.
    """
    desc = agent_event.get("description") or ""
    stype = agent_event.get("subagent_type")
    for jsonl, meta in candidates:
        if jsonl in used:
            continue
        if meta.get("description") != desc:
            continue
        if stype is not None and meta.get("agentType") != stype:
            continue
        used.add(jsonl)
        return jsonl
    for jsonl, meta in candidates:
        if jsonl in used:
            continue
        if stype is not None and meta.get("agentType") != stype:
            continue
        used.add(jsonl)
        return jsonl
    return None


def render_events(
    events: list[dict],
    jsonl_path: Path,
    recurse: bool,
    depth: int,
    max_depth: int,
) -> list[str]:
    candidates = index_subagents(jsonl_path) if recurse and depth < max_depth else []
    used: set[Path] = set()
    pieces: list[str] = []
    agent_idx = 0
    for ev in events:
        if ev["kind"] == "agent_call":
            agent_idx += 1
            pieces.append(render_agent_event(agent_idx, ev))
            if recurse and depth < max_depth:
                inner = match_subagent(ev, candidates, used)
                if inner is not None:
                    pieces.append(render_subagent_trace(inner, depth + 1, max_depth))
        elif ev["kind"] == "assistant_text":
            pieces.append(render_assistant_text_event(ev))
        elif ev["kind"] == "bash_call":
            pieces.append(render_bash_event(ev))
    return pieces


def render_subagent_trace(jsonl: Path, depth: int, max_depth: int) -> str:
    """Render a subagent's full event timeline inside a collapsible <details> block.

    Keeps the top-level scan fast; expand the block to see the subagent's own
    bash/text/agent activity. Renders collapsibly on GitHub and most markdown
    viewers; the pager shows it inline (still readable).
    """
    records = load_records(jsonl)
    events = collect_events(records)
    inner = render_events(events, jsonl, recurse=True, depth=depth, max_depth=max_depth)
    body = "\n".join(inner) if inner else "(empty trace)"
    return "\n".join([
        "",
        f"<details><summary>Inner trace (subagent session {jsonl.stem}, depth {depth})</summary>",
        "",
        body,
        "",
        "</details>",
        "",
    ])


def render_markdown(session_path: Path, records: list[dict], recurse_subagents: bool = False) -> str:
    meta = session_metadata(records)
    events = collect_events(records)

    pieces = [render_header(session_path, meta)]
    pieces.extend(
        render_events(
            events,
            session_path,
            recurse=recurse_subagents,
            depth=0,
            max_depth=3,
        )
    )
    return "\n".join(pieces) + "\n"


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------


def cmd_list(project_root: Path) -> int:
    sessions = list_sessions(project_root)
    if not sessions:
        print(f"no sessions for {project_root} in {PROJECTS_DIR}")
        return 0
    for s in sessions:
        records = load_records(s)
        meta = session_metadata(records)
        ts = meta.get("started") or "?"
        title = meta.get("title") or "(no title)"
        # Mark worktree sessions so users can tell them apart.
        canonical = PROJECTS_DIR / encode_project_path(project_root)
        marker = "" if s.parent == canonical or s.parent.name == "subagents" and s.parent.parent.parent == canonical else "  [worktree]"
        print(f"{s.stem}  {ts}  {title}{marker}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(
        prog="claude-replay",
        description="Extract subagent transcripts from a Claude Code session log.",
    )
    p.add_argument(
        "session",
        nargs="?",
        help="session UUID (searched globally under ~/.claude/projects/). Default: latest session in the cwd's project.",
    )
    p.add_argument("--latest", action="store_true", help="use the most recent session in the cwd's project (default)")
    p.add_argument("--project", help="project root path used for --latest/--list (default: git toplevel of cwd)")
    p.add_argument("--list", action="store_true", help="list sessions in the cwd's project, newest first")
    p.add_argument("--commit", help="locate session via `find-session <hash>` and replay it")
    p.add_argument(
        "--recurse-subagents",
        action="store_true",
        help="inline each subagent's full trace inside a collapsible block under its Agent call (depth-capped at 3)",
    )
    args = p.parse_args()

    if args.list:
        return cmd_list(resolve_project_root(args.project))

    if args.commit:
        session_path = session_via_commit(args.commit)
        if session_path is None:
            print(f"error: could not resolve session for commit {args.commit}", file=sys.stderr)
            return 1
    elif args.session:
        session_path = session_by_uuid(args.session)
        if session_path is None:
            print(
                f"error: no session {args.session} under {PROJECTS_DIR}",
                file=sys.stderr,
            )
            return 1
    else:
        project_root = resolve_project_root(args.project)
        session_path = latest_session(project_root)
        if session_path is None:
            print(
                f"error: no sessions for {project_root} in {PROJECTS_DIR}",
                file=sys.stderr,
            )
            return 1

    records = load_records(session_path)
    text = render_markdown(session_path, records, recurse_subagents=args.recurse_subagents)

    if sys.stdout.isatty():
        # Honour $PAGER if set; pydoc.pager respects it.
        pager(text)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
