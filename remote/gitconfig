[user]
	name = Patric Fornasier
	email = the configured Gmail account

[pull]
	rebase = true
	ff = only
[rebase]
	autoStash = true
[fetch]
	prune = true
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[merge]
	conflictStyle = zdiff3

[core]
	editor = nvim
	autocrlf = false
	pager = delta

[color]
	ui = auto
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"
[interactive]
	diffFilter = delta --color-only

[alias]
	sbs = -c delta.side-by-side=true diff

[rerere]
	enabled = true

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
