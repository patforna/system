# --- Paths ---
export PATH="$HOME/.local/bin:$HOME/.atuin/bin:$PATH"

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history
setopt hist_ignore_dups
setopt hist_reduce_blanks

# --- Completion ---
autoload -Uz compinit && compinit  # no -C: it trusts a stale ~/.zcompdump and misses newly installed completions
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# --- Keybindings ---
bindkey -v
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# --- Usability ---
setopt autocd
setopt correct
setopt interactive_comments
setopt no_beep
setopt auto_pushd pushd_ignore_dups

# --- Prompt ---
eval "$(starship init zsh)"

# --- Tools ---
eval "$(zoxide init zsh)"

# fzf must be sourced BEFORE atuin so atuin's Ctrl-R binding wins.
export FZF_DEFAULT_COMMAND='rg --files --hidden --follow -g "!.git"'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
source <(fzf --zsh)

eval "$(atuin init zsh --disable-up-arrow)"

# --- Aliases ---
alias cat='bat'
alias l=less
alias rg='rg --hidden --smart-case'
alias g='rg'
alias grep='rg'
alias vim='nvim'
alias lg='lazygit'

# eza
alias ls="eza --group-directories-first --icons=auto"
alias la="eza -la --group-directories-first --icons=auto"
alias lt='eza --tree --level=2 --group-directories-first --icons=auto --all'
alias lls='eza -l --sort=size --total-size'
alias llm='eza -l --sort=modified'

# zoxide
alias j='z'
alias jj='zi'

# git
alias gco='git checkout'
alias gcb='git switch -c'
alias gsw='git switch'
alias ga='git add'
alias gaa='git add -A'
alias gc='git commit'
alias gcm='git commit -m'
alias 'gc!'='git commit --amend'
alias gcl='git clone'
alias gd='git diff'
alias gdp='git --no-pager diff'
alias gds='git diff --staged'
# gsbs: side-by-side delta for ANY git subcommand — gsbs diff main...HEAD | gsbs show <sha> | gsbs log -p
gsbs() { git -c delta.side-by-side=true "$@"; }
alias gpl='git pull --rebase'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gst='git status -sb'
alias gss='git status'
alias gb='git branch'
alias gba='git branch -a'
alias gbd='git branch -d'
alias gbD='git branch -D'
alias gm='git merge'
alias gfr='git fetch --all --prune'
alias gsta='git stash'
alias gstp='git stash pop'
alias gstd='git stash drop'
alias gstl='git stash list'
alias gl=glo
alias glo='git log --oneline --graph --decorate'
alias glgp='git log --oneline --graph --decorate --patch'
alias glgs='git log --stat'
alias gundo='git restore .'
alias gwip='git add -A && git commit -m "WIP"'
alias gclean='git reset --hard && git clean -fd'
alias gr='git rebase'
alias gri='git rebase -i'
alias grc='git rebase --continue'
alias gra='git rebase --abort'

# tad
alias jt='just tasks'
alias jb='just backlog'
alias jc='just check'

# misc
alias vz='vim ~/.zshrc'
alias sz='source ~/.zshrc'

# --- Environment ---
export EDITOR="nvim"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
  export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_PERSONAL_ACCESS_TOKEN:-$(gh auth token)}"
fi

# --- Plugins (must be last) ---
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# TAB: fzf-enhanced completion (expands unambiguously, fuzzy picks when multiple matches).
# Bound explicitly because vi mode leaves ^I unbound, which breaks fzf's fallback.
# Autosuggestions are accepted with right-arrow (zsh-autosuggestions default).
bindkey '^I' fzf-completion
bindkey -M vicmd '^I' fzf-completion   # also complete in vi normal mode

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
