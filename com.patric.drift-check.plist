<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.patric.drift-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>eval "$(/opt/homebrew/bin/brew shellenv)" &amp;&amp; exec "${HOME}/github/system/scripts/drift-check.sh" --notify</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/drift-check.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/drift-check.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
